    <color name="folio_ink">#141414</color>
    <style name="FolioTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/folio_bg</item>
        <item name="android:statusBarColor">@color/folio_bg</item>
